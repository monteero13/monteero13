# Keep LF in the repo for anything the Linux Actions runners execute.
# A CRLF line ending inside a `run: |` block makes bash fail with
# "command not found" on an otherwise correct script.
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.svg   text eol=lf

*.ps1   text eol=crlf

*.png   binary
*.jpg   binary

# Generated by scripts/build.py (and by the CI bot). On a pull, keep the local
# copy instead of conflicting: both sides come from profile.toml, so rebuilding
# gives the right result. Needs once per clone:  git config merge.ours.driver true
assets/generated/** merge=ours
README.md           merge=ours
README.*.md         merge=ours
